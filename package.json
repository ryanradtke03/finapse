{
  "name": "finapse",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run db:up && concurrently -k -n api,web -c blue,green npm:dev:api npm:dev:web",
    "dev:demo": "npm run db:up && concurrently -k -n api,web -c magenta,cyan npm:dev:api:demo npm:dev:web:demo",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api:demo": "npm --workspace apps/api run dev:demo",
    "dev:web:demo": "npm --workspace apps/web run dev -- --mode demo",
    "seed:demo": "npm --workspace apps/api run db:seed:demo",
    "reset:demo": "npm run db:up && npm --workspace apps/api run db:reset:demo",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "build:demo": "npm --workspace apps/web run build -- --mode demo",
    "start:api": "npm --workspace apps/api run start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v",
    "backend:up": "docker compose up -d backend",
    "backend:logs": "docker compose logs -f backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.0"
  }
}
