generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plaidItems   PlaidItem[]
  budgets      Budget[]

  @@map("users")
}

// ─────────────────────────────────────────
// PLAID
// ─────────────────────────────────────────

// One PlaidItem = one connected bank/institution (e.g. Chase, BofA)
// A user can have multiple. The accessToken is sensitive — encrypt at rest.
model PlaidItem {
  id                String    @id @default(uuid())
  
  // ⚠️  Encrypt this before storing — treat like a password
  accessToken       String    @map("access_token")
  
  plaidItemId       String    @unique @map("plaid_item_id")
  institutionId     String?   @map("institution_id")
  institutionName   String?   @map("institution_name")

  // Cursor for /transactions/sync — store after every sync
  // Start without one; Plaid returns one on first call
  transactionCursor String?   @map("transaction_cursor")

  // Plaid can mark items as needing re-authentication
  status            PlaidItemStatus @default(ACTIVE)

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accounts          Account[]

  @@map("plaid_items")
}

enum PlaidItemStatus {
  ACTIVE
  NEEDS_REAUTH  // item.login_required webhook → prompt user to reconnect
  DISCONNECTED
}

// One PlaidItem has many Accounts (checking, savings, credit card, etc.)
model Account {
  id              String      @id @default(uuid())
  plaidAccountId  String      @unique @map("plaid_account_id")
  name            String                          // e.g. "Sapphire Reserve"
  officialName    String?     @map("official_name")
  mask            String?                         // last 4 digits
  type            String                          // depository | credit | investment | loan
  subtype         String?                         // checking | savings | credit card | etc.

  // Balances — update on each sync
  balanceCurrent  Decimal?    @map("balance_current")  @db.Decimal(12, 2)
  balanceAvailable Decimal?   @map("balance_available") @db.Decimal(12, 2)
  isoCurrencyCode String?     @map("iso_currency_code") @default("USD")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  plaidItemId     String      @map("plaid_item_id")
  plaidItem       PlaidItem   @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  transactions    Transaction[]

  @@map("accounts")
}

// ─────────────────────────────────────────
// TRANSACTIONS
// ─────────────────────────────────────────

model Transaction {
  id                    String    @id @default(uuid())
  plaidTransactionId    String    @unique @map("plaid_transaction_id")

  amount                Decimal   @db.Decimal(12, 2)   // positive = debit, negative = credit (Plaid convention)
  isoCurrencyCode       String?   @map("iso_currency_code") @default("USD")

  date                  DateTime                        // date of the transaction (not posted date)
  name                  String                          // raw merchant name from Plaid
  merchantName          String?   @map("merchant_name") // cleaned merchant name (Plaid enriches this)

  // Plaid's category taxonomy — store both for flexibility
  // e.g. category: ["Food and Drink", "Restaurants"]
  // personalFinanceCategory is Plaid's newer, better categorization
  category              String[]                        // legacy: ["Food and Drink", "Restaurants"]
  personalFinanceCategory String? @map("personal_finance_category") // new: "FOOD_AND_DRINK_RESTAURANTS"

  pending               Boolean   @default(false)       // pending transactions can change/disappear
  
  // Recurring detection — set by your background job
  isRecurring           Boolean   @default(false) @map("is_recurring")
  recurringFrequency    RecurringFrequency? @map("recurring_frequency")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  accountId             String    @map("account_id")
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([personalFinanceCategory])
  @@map("transactions")
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ANNUALLY
}

// ─────────────────────────────────────────
// BUDGETS
// ─────────────────────────────────────────

// One budget = one category cap for one calendar month
// e.g. "Food & Dining, March 2025, $500"
model Budget {
  id        String   @id @default(uuid())

  // Match this against personalFinanceCategory on Transaction
  category  String                          // e.g. "FOOD_AND_DRINK"

  limitAmount Decimal @map("limit_amount") @db.Decimal(12, 2)

  // Which month this budget applies to (store as first day of month, e.g. 2025-03-01)
  periodStart DateTime @map("period_start") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One budget per category per month per user
  @@unique([userId, category, periodStart])
  @@index([userId, periodStart])
  @@map("budgets")
}

