generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plaidItems   PlaidItem[]
  budgets      Budget[]

  @@map("users")
}

// ─────────────────────────────────────────
// PLAID
// ─────────────────────────────────────────

model PlaidItem {
  id                String          @id @default(uuid())

  // ⚠️ Encrypted with AES-256-GCM before storing — never plaintext
  accessToken       String          @map("access_token")

  // Plaid's stable identifier for this connection
  itemId            String          @unique @map("item_id")

  institutionId     String?         @map("institution_id")
  institutionName   String?         @map("institution_name")

  // Cursor for /transactions/sync — null = never synced (triggers full history fetch)
  // Update this after every successful sync inside a DB transaction
  transactionCursor String?         @map("transaction_cursor")

  // NEEDS_REAUTH = item.login_required webhook — prompt user to reconnect
  status            PlaidItemStatus @default(ACTIVE)

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  userId            String          @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  accounts          Account[]

  @@map("plaid_items")
}

enum PlaidItemStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
}

model Account {
  id               String      @id @default(uuid())
  plaidAccountId   String      @unique @map("plaid_account_id")
  name             String
  officialName     String?     @map("official_name")
  mask             String?
  type             String
  subtype          String?

  balanceCurrent   Decimal?    @map("balance_current")   @db.Decimal(12, 2)
  balanceAvailable Decimal?    @map("balance_available") @db.Decimal(12, 2)
  isoCurrencyCode  String?     @map("iso_currency_code") @default("USD")

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  plaidItemId      String      @map("plaid_item_id")
  plaidItem        PlaidItem   @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)

  transactions     Transaction[]

  @@map("accounts")
}

// ─────────────────────────────────────────
// TRANSACTIONS
// ─────────────────────────────────────────

model Transaction {
  id                             String              @id @default(uuid())
  plaidTransactionId             String              @unique @map("plaid_transaction_id")

  amount                         Decimal             @db.Decimal(12, 2)
  isoCurrencyCode                String?             @map("iso_currency_code") @default("USD")

  date                           DateTime
  name                           String
  merchantName                   String?             @map("merchant_name")

  category                       String[]
  personalFinanceCategory        String?             @map("personal_finance_category")
  personalFinanceCategoryDetail  String?             @map("personal_finance_category_detail")

  userCategory                   String?             @map("user_category")

  // Free-form user annotations (FIN-48 / FIN-56)
  notes                          String?
  tags                           String[]            @default([])

  // PLAID = synced from a bank connection; MANUAL = user-entered (FIN-47).
  // Only MANUAL transactions may be deleted — a synced row would just come
  // back on the next Plaid sync.
  source                         TransactionSource   @default(PLAID)

  // Soft-delete marker (FIN-49). Non-null = hidden from all queries.
  deletedAt                      DateTime?           @map("deleted_at")

  paymentChannel                 String?             @map("payment_channel")
  merchantEntityId               String?             @map("merchant_entity_id")
  location                       String?

  pending                        Boolean             @default(false)

  isRecurring                    Boolean             @default(false) @map("is_recurring")
  recurringFrequency             RecurringFrequency? @map("recurring_frequency")

  createdAt                      DateTime            @default(now()) @map("created_at")
  updatedAt                      DateTime            @updatedAt @map("updated_at")

  accountId                      String              @map("account_id")
  account                        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([personalFinanceCategory])
  @@index([userCategory])
  @@map("transactions")
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ANNUALLY
}

enum TransactionSource {
  PLAID
  MANUAL
}

// ─────────────────────────────────────────
// BUDGETS
// ─────────────────────────────────────────

model Budget {
  id          String   @id @default(uuid())
  category    String
  limitAmount Decimal  @map("limit_amount") @db.Decimal(12, 2)
  periodStart DateTime @map("period_start") @db.Date

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, periodStart])
  @@index([userId, periodStart])
  @@map("budgets")
}

