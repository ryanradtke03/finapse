# Server
PORT=3001
NODE_ENV=development

# Database (Postgres)
# Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meal_planner?schema=public"
DATABASE_URL=

# CORS / Frontend origin (what the browser runs on)
# Comma-separated if you need more than one (e.g. two local dev ports)
# Example: http://localhost:5173,http://localhost:5174
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate limiting: number of proxy hops to trust so per-IP limits key on the
# real client IP when deployed behind a proxy/load balancer (e.g. "1").
# Leave unset for local dev. Do NOT blindly set high — clients could spoof
# X-Forwarded-For to bypass limits.
TRUST_PROXY=

# Base URL of the frontend, used to build links in verification / password-
# reset emails. Falls back to the first CLIENT_ORIGIN, then localhost.
APP_URL=http://localhost:5173


JWT_SECRET= A SECRET STRING USED TO SIGN JWT TOKENS
JWT_EXPIRES_IN= SOME AMT OF TIME (e.g. 7d, 24h, 60m, etc.)

# AES-256-GCM key used to encrypt Plaid access tokens at rest.
# Must be a 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Plaid API credentials (https://dashboard.plaid.com)
# PLAID_ENV selects which Plaid environment (and base URL) the client targets.
# Supported values: "sandbox" | "production". An invalid value fails fast at boot.
# The active environment is logged at startup so you can confirm which is live.
#
# Recommended split:
#   - Public demo deploy: PLAID_ENV=sandbox. Anyone can click through with
#     Plaid's test creds (user_good / pass_good) — no real data, no cost.
#   - Local personal use: PLAID_ENV=production. Connects your real bank.
#     NEVER put production keys in a deployed/public environment.
#
# client_id is the SAME for both environments; only the secret differs.
# Keep BOTH secrets below and just flip PLAID_ENV to switch — the app picks the
# secret matching PLAID_ENV (PLAID_SECRET_PRODUCTION or PLAID_SECRET_SANDBOX),
# falling back to the generic PLAID_SECRET if the per-env one isn't set.
PLAID_CLIENT_ID=
PLAID_ENV=sandbox
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
# Optional single-secret fallback (used if the per-env secret above is blank):
PLAID_SECRET=
# Public URL Plaid POSTs webhooks to, e.g. https://<your-tunnel>/api/v1/plaid/webhook
# Local dev needs a tunnel (ngrok/cloudflared) since Plaid must reach your machine.
# Leave blank to disable webhooks (manual "Sync now" still works).
PLAID_WEBHOOK_URL=