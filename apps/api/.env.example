# Server
PORT=3001
NODE_ENV=development

# Database (Postgres)
# Example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meal_planner?schema=public"
DATABASE_URL=

# CORS / Frontend origin (what the browser runs on)
# Comma-separated if you need more than one (e.g. two local dev ports)
# Example: http://localhost:5173,http://localhost:5174
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Rate limiting: number of proxy hops to trust so per-IP limits key on the
# real client IP when deployed behind a proxy/load balancer (e.g. "1").
# Leave unset for local dev. Do NOT blindly set high — clients could spoof
# X-Forwarded-For to bypass limits.
TRUST_PROXY=


JWT_SECRET= A SECRET STRING USED TO SIGN JWT TOKENS
JWT_EXPIRES_IN= SOME AMT OF TIME (e.g. 7d, 24h, 60m, etc.)

# AES-256-GCM key used to encrypt Plaid access tokens at rest.
# Must be a 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Plaid API credentials (https://dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox