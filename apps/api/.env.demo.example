# Demo-mode API env for LOCAL runs (see docs/DEMO_MODE.md).
# Copy to `apps/api/.env.demo` (gitignored) and fill the secrets.
# Used by: npm run dev:demo / seed:demo / reset:demo (all from the repo root).

# Isolated demo database — SEPARATE from your dev DB so `reset:demo` can never
# touch your real data. Prisma creates it automatically on the first reset:demo.
DATABASE_URL="postgresql://finapse:finapse_password@localhost:5432/finapse_demo?schema=public"

# ── Demo posture ─────────────────────────────────────────────
DEMO_MODE=true          # disable signup + destructive auth actions
PLAID_ENV=sandbox       # fake sandbox data, no cost
EMAIL_PROVIDER=console  # no real email; links log to the console
SEED_DEMO=true          # allow the demo account to be seeded

# ── Secrets (fill these in) ──────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# 64-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Plaid Sandbox credentials (dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=

# Frontend origins for CORS (local Vite dev server)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
APP_URL=http://localhost:5173
