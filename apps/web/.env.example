# Vite exposes ONLY variables prefixed with VITE_ (baked in at build time —
# rebuild after changing).

# API base including the version prefix.
# Leave blank for local dev (defaults to http://localhost:3001/api/v1).
#
# In PRODUCTION this must be the RELATIVE path "/api/v1", so calls go to the
# frontend's own origin and the platform rewrite forwards them to the API (see
# render.yaml). Setting it to the API's absolute URL makes the auth cookie
# third-party, which iOS Safari blocks: login looks like it works, then nothing
# loads and a refresh kicks you back to the landing page.
VITE_API_URL=

# "true" on the public Plaid Sandbox demo — hides signup, funnels everyone
# through the seeded demo account, and surfaces the sandbox credentials.
# Blank for normal operation.
VITE_DEMO_MODE=
