# Demo-mode frontend env, loaded automatically by `vite --mode demo`
# (i.e. npm run dev:demo / build:demo). Copy to `apps/web/.env.demo`.

# Hides signup, funnels to the demo account, surfaces sandbox credentials.
VITE_DEMO_MODE=true

# Full API base incl. /api/v1. Leave blank locally to use the default
# (http://localhost:3001/api/v1).
VITE_API_URL=
