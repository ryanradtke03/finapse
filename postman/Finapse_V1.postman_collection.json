            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Recipie to delete\",\n  \"description\": \"Creamy garlic butter chicken pasta with parmesan.\",\n  \"servings\": 4,\n  \"prepTimeMin\": 15,\n  \"cookTimeMin\": 25,\n  \"ingredients\": [\n    {\n      \"name\": \"Chicken Breast\",\n      \"amount\": \"2 large\"\n    },\n    {\n      \"name\": \"Pasta\",\n      \"amount\": \"250g\"\n    },\n    {\n      \"name\": \"Garlic\",\n      \"amount\": \"3 cloves\"\n    },\n    {\n      \"name\": \"Butter\",\n      \"amount\": \"2 tbsp\"\n    },\n    {\n      \"name\": \"Heavy Cream\",\n      \"amount\": \"1 cup\"\n    },\n    {\n      \"name\": \"Parmesan Cheese\",\n      \"amount\": \"1/2 cup\"\n    },\n    {\n      \"name\": \"Salt\",\n      \"amount\": \"to taste\"\n    },\n    {\n      \"name\": \"Black Pepper\",\n      \"amount\": \"to taste\"\n    }\n  ],\n  \"steps\": [\n    {\n      \"order\": 1,\n      \"title\": \"Boil Pasta\",\n      \"instructions\": \"Bring a large pot of salted water to a boil and cook pasta according to package instructions.\"\n    },\n    {\n      \"order\": 2,\n      \"title\": \"Cook Chicken\",\n      \"instructions\": \"Season chicken with salt and pepper, then cook in butter over medium heat until golden and cooked through.\"\n    },\n    {\n      \"order\": 3,\n      \"title\": \"Prepare Sauce\",\n      \"instructions\": \"Add minced garlic to the pan and cook until fragrant. Pour in heavy cream and simmer for 5 minutes.\"\n    },\n    {\n      \"order\": 4,\n      \"title\": \"Combine\",\n      \"instructions\": \"Stir in parmesan cheese until melted. Add drained pasta and toss to coat evenly.\"\n    },\n    {\n      \"order\": 5,\n      \"title\": \"Serve\",\n      \"instructions\": \"Plate and garnish with additional parmesan and fresh parsley if desired.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
